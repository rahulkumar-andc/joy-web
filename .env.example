# ============================================================================
# Environment Variables - Luxury Fashion E-Commerce Platform
# ============================================================================

# ============================================================================
# REQUIRED IN PRODUCTION
# ============================================================================

# Database (PostgreSQL 16+)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# Session Secret (CRITICAL: Use strong random string in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-strong-random-secret-in-production

# Razorpay Payment Gateway (REQUIRED for checkout)
# Get from: https://dashboard.razorpay.com/app/keys
# IMPORTANT: Use rzp_live_* keys in production, NOT rzp_test_*
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================================
# REQUIRED FOR FEATURES
# ============================================================================

# Redis Cache (Upstash or self-hosted)
# Upstash: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Email Service (SMTP)
# Gmail example: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM='"Your Store Name" <noreply@yourstore.com>'

# ============================================================================
# OPTIONAL
# ============================================================================

# Node Environment (default: development)
NODE_ENV=development

# Server Port (default: 5000)
PORT=5000

# Base URL for email links and redirects (default: http://localhost:5173)
BASE_URL=http://localhost:5173

# Stripe (Optional - if using Stripe instead of/alongside Razorpay)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Set to "true" to enable verbose logging
DEBUG=true

# ============================================================================
# PHASE 3: SCALE PREPARATION
# ============================================================================

# BullMQ Queue Redis (can be same as Upstash or separate Redis instance)
# Required for background job processing (emails, notifications)
# Options: Redis URL, Railway Redis, Render Redis, or local Redis
QUEUE_REDIS_URL=redis://localhost:6379

# Alternative: Use standard Redis connection
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# MeiliSearch (Product Search Engine)
# Self-hosted: https://www.meilisearch.com/docs/learn/getting_started/quick_start
# Cloud: https://cloud.meilisearch.com
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_master_key_here

# Query Performance Monitoring
# Queries taking longer than this threshold will be logged as warnings
SLOW_QUERY_THRESHOLD_MS=100

# Database Backup Configuration
# Directory to store local backups
BACKUP_DIR=./backups
# Number of days to keep backups before cleanup
BACKUP_RETENTION_DAYS=30
# Enable gzip compression for backups (default: true)
BACKUP_COMPRESSION=true

# Optional: S3 Backup Upload
# If set, backups will be uploaded to this S3 bucket
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_S3_REGION=us-east-1